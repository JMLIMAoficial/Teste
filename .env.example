# ─── Local dev (default) ───────────────────────────────────────
DATABASE_URL="postgresql://acompanhante:acompanhante_dev@localhost:5432/acompanhante"
DIRECT_DATABASE_URL="postgresql://acompanhante:acompanhante_dev@localhost:5432/acompanhante"

# ─── Supabase (production / staging) ─────────────────────────
# Dashboard → Project Settings → Database
#
# DATABASE_URL (Transaction pooler, port 6543 — use in API runtime):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
#
# DIRECT_DATABASE_URL (Session/direct, port 5432 — use for migrations & prisma db push):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Steps:
# 1. Run scripts/supabase-schemas.sql in Supabase SQL Editor
# 2. DIRECT_DATABASE_URL=... npx prisma db push
# 3. DIRECT_DATABASE_URL=... npm run db:seed

# Supabase Storage (optional — replaces MinIO in production)
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# SUPABASE_STORAGE_BUCKET="acompanhante-media"

# Redis
REDIS_URL="redis://localhost:6379"
# Production: Upstash Redis — https://upstash.com (works well with Vercel)

# Meilisearch
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_KEY="meili_dev_master_key"

# S3 / MinIO (local dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="acompanhante-media"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:4000/api/v1/media"
UPLOAD_DIR="../../uploads"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# Auth
JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="dev-jwt-refresh-secret-change-in-production"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_DAYS=7
WHATSAPP_ENCRYPTION_KEY="dev-whatsapp-key-change-in-production"
CORS_ORIGIN="http://localhost:3000"

# Email
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="noreply@acompanhante.local"
# Production: Resend, SendGrid, or Supabase Auth emails

# ─── Web (Vercel) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
SEO_SITE_NAME="Acompanhante"

# Vercel production example:
# NEXT_PUBLIC_API_URL="https://api.seudominio.com"
# NEXT_PUBLIC_SITE_URL="https://seudominio.com"
# CORS_ORIGIN="https://seudominio.com"
